{%- liquid
  assign p = product
  assign current = p.selected_or_first_available_variant
-%}
<section class="dk dk-pdp" data-dk-pdp data-dk-product-url="{{ p.url }}">
  <div class="dk-wrap">
    <nav class="dk-pdp__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Desk mats</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ p.title }}</span>
    </nav>

    <div class="dk-pdp__grid">
      {%- comment -%} ---------------------------------------- gallery {%- endcomment -%}
      <div class="dk-pdp__gallery">
        <div class="dk-pdp__stage" data-dk-reveal="scale">
          {%- if p.media.size > 0 -%}
            {%- for media in p.media -%}
              <img
                class="dk-pdp__shot{% if forloop.first %} is-active{% endif %}"
                data-dk-shot="{{ forloop.index0 }}"
                src="{{ media.preview_image | image_url: width: 1400 }}"
                alt="{{ media.alt | default: p.title | escape }}"
                width="1400" height="1400"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            {%- endfor -%}
          {%- else -%}
            <img class="dk-pdp__shot is-active" src="{{ 'dk-product.jpg' | asset_url }}" alt="{{ p.title | escape }}" width="1400" height="1400">
          {%- endif -%}

          {%- if p.compare_at_price > p.price -%}
            <span class="dk-pdp__badge">Save {{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%</span>
          {%- endif -%}
        </div>

        {%- if p.media.size > 1 -%}
          <ul class="dk-pdp__thumbs" data-dk-stagger>
            {%- for media in p.media -%}
              <li>
                <button type="button" class="dk-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-dk-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                  <img src="{{ media.preview_image | image_url: width: 220 }}" alt="" width="110" height="110" loading="lazy">
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ------------------------------------------- info {%- endcomment -%}
      <div class="dk-pdp__info">
        <div class="dk-pdp__sticky">
          {%- if p.vendor != blank -%}<p class="dk-eyebrow" data-dk-reveal>{{ p.vendor }}</p>{%- endif -%}
          <h1 class="dk-pdp__title" data-dk-reveal data-dk-delay="50">{{ p.title }}</h1>

          <p class="dk-pdp__price" data-dk-reveal data-dk-delay="80">
            <span data-dk-price>{{ current.price | money }}</span>
            {%- if current.compare_at_price > current.price -%}
              <s data-dk-compare>{{ current.compare_at_price | money }}</s>
            {%- else -%}
              <s data-dk-compare hidden></s>
            {%- endif -%}
          </p>

          <p class="dk-pdp__stock{% unless current.available %} is-out{% endunless %}" data-dk-stock data-dk-reveal data-dk-delay="100">
            <span aria-hidden="true"></span><em data-dk-stock-text>{% if current.available %}In stock, ready to dispatch{% else %}Currently unavailable{% endif %}</em>
          </p>

          {%- if p.description != blank -%}
            <div class="dk-body dk-pdp__blurb" data-dk-reveal data-dk-delay="120">{{ p.description | strip_html | truncatewords: 42 }}</div>
          {%- endif -%}

          {%- form 'product', p, class: 'dk-pdp__form dk-buy__form', id: 'dk-pdp-form' -%}
            <input type="hidden" name="id" value="{{ current.id }}" data-dk-variant-id>

            {%- unless p.has_only_default_variant -%}
              <div class="dk-pdp__options" data-dk-options>
                {%- for option in p.options_with_values -%}
                  <fieldset class="dk-opt" data-dk-opt-index="{{ forloop.index0 }}">
                    <legend class="dk-opt__legend">
                      {{ option.name }}
                      <span class="dk-opt__value" data-dk-opt-value="{{ forloop.index0 }}">{{ option.selected_value }}</span>
                    </legend>
                    <div class="dk-opt__pills">
                      {%- for value in option.values -%}
                        <label class="dk-opt__pill{% if value == option.selected_value %} is-on{% endif %}">
                          <input
                            type="radio"
                            name="dk-option-{{ forloop.parentloop.index0 }}"
                            value="{{ value | escape }}"
                            data-dk-opt-input="{{ forloop.parentloop.index0 }}"
                            {% if value == option.selected_value %}checked{% endif %}>
                          <span>{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="dk-pdp__buy" data-dk-buy-anchor>
              <div class="dk-qty">
                <button type="button" class="dk-qty__btn" data-dk-qty="-1" aria-label="Decrease quantity">&minus;</button>
                <input class="dk-qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
                <button type="button" class="dk-qty__btn" data-dk-qty="1" aria-label="Increase quantity">+</button>
              </div>
              <button type="submit" class="dk-btn dk-buy__add" data-dk-add {% unless current.available %}disabled{% endunless %}>
                {% if current.available %}Add to cart{% else %}Sold out{% endif %}
              </button>
            </div>
          {%- endform -%}

          <ul class="dk-pdp__assure" data-dk-stagger>
            {%- for block in section.blocks -%}
              {%- if block.type == 'assurance' -%}
                <li {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4 4 10-10.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <div class="dk-acc">
            {%- if p.description != blank -%}
              <details class="dk-acc__item" open>
                <summary>Description<span class="dk-acc__sign" aria-hidden="true"></span></summary>
                <div class="dk-acc__body dk-rte">{{ p.description }}</div>
              </details>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'panel' -%}
                <details class="dk-acc__item" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title }}<span class="dk-acc__sign" aria-hidden="true"></span></summary>
                  <div class="dk-acc__body dk-rte">{{ block.settings.body }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} mobile sticky buy bar {%- endcomment -%}
  <div class="dk-stickybuy" data-dk-stickybuy>
    <span class="dk-stickybuy__info">
      <span class="dk-stickybuy__name">{{ p.title }}</span>
      <span class="dk-stickybuy__price" data-dk-price>{{ current.price | money }}</span>
    </span>
    <button type="submit" form="dk-pdp-form" class="dk-btn" {% unless current.available %}disabled{% endunless %}>
      {% if current.available %}Add to cart{% else %}Sold out{% endif %}
    </button>
  </div>

  <script type="application/json" data-dk-variants>
    {{ p.variants | json }}
  </script>
</section>

{% stylesheet %}
  .dk-pdp { background: var(--dk-paper); padding-block: 22px clamp(50px, 7vw, 96px); }
  .dk-pdp__crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.8125rem; color: var(--dk-muted); margin-bottom: clamp(18px, 3vw, 34px); }
  .dk-pdp__crumbs a { color: var(--dk-muted); text-decoration: none; }
  .dk-pdp__crumbs a:hover { color: var(--dk-ink); text-decoration: underline; }
  .dk-pdp__crumbs [aria-current] { color: var(--dk-ink); }

  .dk-pdp__grid { display: grid; gap: clamp(26px, 4vw, 56px); align-items: start; }
  @media (min-width: 900px) { .dk-pdp__grid { grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr); } }

  .dk-pdp__stage { position: relative; aspect-ratio: 1 / 1; background: var(--dk-sand); overflow: hidden; }
  .dk-pdp__shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.45s var(--dk-ease); }
  .dk-pdp__shot.is-active { opacity: 1; }
  .dk-pdp__badge { position: absolute; top: 14px; left: 14px; z-index: 3; background: var(--dk-flash); color: #fff; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 6px 10px; }

  .dk-pdp__thumbs { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 74px; gap: 10px; overflow-x: auto; scrollbar-width: none; }
  .dk-pdp__thumbs::-webkit-scrollbar { display: none; }
  .dk-pdp__thumb { padding: 0; border: 1px solid var(--dk-stone); background: var(--dk-sand); cursor: pointer; display: block; width: 74px; aspect-ratio: 1/1; overflow: hidden; transition: border-color 0.25s var(--dk-ease); }
  .dk-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dk-pdp__thumb.is-active { border-color: var(--dk-ink); }
  .dk-pdp__thumb:hover { border-color: var(--dk-ink); }

  .dk-pdp__sticky { display: flex; flex-direction: column; gap: 14px; }
  @media (min-width: 1100px) { .dk-pdp__sticky { position: sticky; top: 108px; } }

  .dk-pdp__title { font-family: var(--font-heading--family, inherit); margin: 0; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; color: var(--dk-ink); }
  .dk-pdp__price { margin: 0; font-size: 1.375rem; font-weight: 500; color: var(--dk-ink); display: flex; align-items: baseline; gap: 10px; }
  .dk-pdp__price s { font-size: 1rem; font-weight: 400; color: var(--dk-muted); }
  .dk-pdp__stock { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 0.875rem; font-style: normal; color: #2f6b3f; }
  .dk-pdp__stock em { font-style: normal; }
  .dk-pdp__stock span { width: 7px; height: 7px; border-radius: 50%; background: #2f6b3f; display: inline-block; }
  .dk-pdp__stock.is-out { color: var(--dk-muted); }
  .dk-pdp__stock.is-out span { background: var(--dk-muted); }
  .dk-pdp__blurb { font-size: 0.9375rem; color: var(--dk-ink-soft); }

  .dk-pdp__options { display: flex; flex-direction: column; gap: 18px; margin-top: 4px; }
  .dk-opt { border: 0; padding: 0; margin: 0; }
  .dk-opt__legend { display: flex; gap: 8px; padding: 0 0 9px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dk-muted); }
  .dk-opt__value { color: var(--dk-ink); letter-spacing: 0.04em; text-transform: none; font-weight: 500; }
  .dk-opt__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .dk-opt__pill { position: relative; cursor: pointer; }
  .dk-opt__pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .dk-opt__pill span { display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border: 1px solid var(--dk-stone); background: var(--dk-card); font-size: 0.875rem; color: var(--dk-ink); transition: border-color 0.2s var(--dk-ease), background 0.2s var(--dk-ease); }
  .dk-opt__pill:hover span { border-color: var(--dk-ink); }
  .dk-opt__pill.is-on span { border-color: var(--dk-ink); background: var(--dk-ink); color: #fff; }
  .dk-opt__pill.is-off span { opacity: 0.4; text-decoration: line-through; }
  .dk-opt__pill input:focus-visible + span { outline: 2px solid var(--dk-ink); outline-offset: 2px; }

  .dk-pdp__buy { display: flex; gap: 10px; margin-top: 6px; }
  .dk-pdp__buy .dk-btn { flex: 1; }
  .dk-qty { display: inline-flex; align-items: center; border: 1px solid var(--dk-stone); background: var(--dk-card); }
  .dk-qty__btn { width: 42px; height: 48px; border: 0; background: transparent; cursor: pointer; font-size: 1.05rem; color: var(--dk-ink); }
  .dk-qty__btn:hover { background: var(--dk-sand); }
  .dk-qty__input { width: 44px; height: 48px; border: 0; background: transparent; text-align: center; font-size: 0.9375rem; color: var(--dk-ink); -moz-appearance: textfield; }
  .dk-qty__input::-webkit-outer-spin-button, .dk-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .dk-pdp__assure { list-style: none; margin: 8px 0 0; padding: 16px 0 0; border-top: 1px solid var(--dk-stone); display: flex; flex-direction: column; gap: 10px; }
  .dk-pdp__assure li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.875rem; color: var(--dk-ink-soft); }
  .dk-pdp__assure svg { width: 16px; height: 16px; flex: none; margin-top: 2px; color: var(--dk-ink); }

  .dk-acc { margin-top: 10px; border-top: 1px solid var(--dk-stone); }
  .dk-acc__item { border-bottom: 1px solid var(--dk-stone); }
  .dk-acc__item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 17px 0; font-size: 0.9375rem; font-weight: 500; color: var(--dk-ink); }
  .dk-acc__item summary::-webkit-details-marker { display: none; }
  .dk-acc__sign { position: relative; width: 13px; height: 13px; flex: none; }
  .dk-acc__sign::before, .dk-acc__sign::after { content: ""; position: absolute; background: var(--dk-ink); transition: transform 0.3s var(--dk-ease); }
  .dk-acc__sign::before { inset: 6px 0 6px 0; height: 1px; }
  .dk-acc__sign::after { inset: 0 6px 0 6px; width: 1px; }
  .dk-acc__item[open] .dk-acc__sign::after { transform: scaleY(0); }
  .dk-acc__body { padding: 0 0 18px; font-size: 0.9375rem; line-height: 1.65; color: var(--dk-ink-soft); }
  .dk-acc__body :is(p, li) { color: var(--dk-ink-soft); }
  .dk-acc__body > *:first-child { margin-top: 0; }
  .dk-acc__body a { color: var(--dk-ink); }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Product",
  "tag": "section",
  "blocks": [
    {
      "type": "assurance",
      "name": "Assurance line",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Dispatched from Lahore" }
      ]
    },
    {
      "type": "panel",
      "name": "Accordion panel",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Delivery and returns" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Delivery times and charges are shown at checkout. Returns are handled under the store refund policy.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "DK Product" }]
}
{% endschema %}
