{%- liquid
  assign img = section.settings.image
-%}
<section class="dk dk-hero" aria-labelledby="dk-hero-title-{{ section.id }}">
  <div class="dk-wrap dk-hero__grid">
    <div class="dk-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dk-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="dk-display" id="dk-hero-title-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="dk-body dk-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}
      <div class="dk-hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="dk-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="dk-btn dk-btn--ghost" href="{{ section.settings.cta2_link | default: '#dk-details' }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="dk-hero__media">
      {%- if img != blank -%}
        {{ img | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'dk-hero__img', alt: img.alt | default: section.settings.heading }}
      {%- else -%}
        <span class="dk-placeholder-tag">Placeholder artwork</span>
        <img class="dk-hero__img" src="{{ 'dk-ph-hero.svg' | asset_url }}" alt="Placeholder workspace illustration" width="1600" height="1100" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.strip_1 != blank -%}
    <div class="dk-wrap">
      <ul class="dk-hero__strip">
        {%- for i in (1..4) -%}
          {%- assign key = 'strip_' | append: i -%}
          {%- assign val = section.settings[key] -%}
          {%- if val != blank -%}<li>{{ val }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .dk-hero { background: var(--dk-paper); padding-block: clamp(32px, 6vw, 72px) 0; }
  .dk-hero__grid {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .dk-hero__copy { display: flex; flex-direction: column; gap: 20px; }
  .dk-hero__body { font-size: 1.0625rem; }
  .dk-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .dk-hero__media {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: var(--dk-sand);
    aspect-ratio: 16 / 11;
  }
  .dk-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dk-hero__strip {
    list-style: none;
    margin: clamp(32px, 5vw, 56px) 0 0;
    padding: 20px 0;
    border-top: 1px solid var(--dk-stone);
    border-bottom: 1px solid var(--dk-stone);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 24px;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--dk-ink-soft);
  }
  @media (min-width: 750px) {
    .dk-hero__grid { grid-template-columns: 0.92fr 1.08fr; gap: 56px; }
    .dk-hero__strip { grid-template-columns: repeat(4, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Desk mats, made for long hours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your desk, finally finished." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "A single surface that quiets the clatter, glides under the mouse and pulls the whole desk together." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop the desk mat" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "See the details" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "header", "content": "Strip" },
    { "type": "text", "id": "strip_1", "label": "Item 1", "default": "Free delivery over —" },
    { "type": "text", "id": "strip_2", "label": "Item 2", "default": "Cash on delivery" },
    { "type": "text", "id": "strip_3", "label": "Item 3", "default": "— day returns" },
    { "type": "text", "id": "strip_4", "label": "Item 4", "default": "Ships from Lahore" }
  ],
  "presets": [{ "name": "DK Hero" }]
}
{% endschema %}
