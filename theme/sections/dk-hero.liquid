{%- liquid
  assign img = section.settings.image
  if img != blank
    assign bg = img | image_url: width: 2400
  else
    assign bg = 'dk-hero.jpg' | asset_url
  endif
-%}
<section class="dk dk-hero" style="--dk-hero-h: {{ section.settings.height }}vh;">
  <div class="dk-hero__bg">
    <img src="{{ bg }}" alt="" class="dk-hero__bgimg" fetchpriority="high" width="2400" height="1600">
    <span class="dk-hero__scrim"></span>
  </div>

  <div class="dk-wrap dk-hero__inner">
    <div class="dk-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dk-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="dk-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="dk-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}
      <div class="dk-hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="dk-btn dk-hero__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="dk-hero__link" href="{{ section.settings.cta2_link | default: '#dk-details' }}">{{ section.settings.cta2_label }}
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.strip_1 != blank -%}
    <div class="dk-hero__striprow">
      <div class="dk-wrap">
        <ul class="dk-hero__strip">
          {%- for i in (1..4) -%}
            {%- assign key = 'strip_' | append: i -%}
            {%- assign val = section.settings[key] -%}
            {%- if val != blank -%}<li>{{ val }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .dk-hero { position: relative; isolation: isolate; background: var(--dk-ink); }
  .dk-hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .dk-hero__bgimg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dk-hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgba(12, 11, 8, 0.86) 0%, rgba(12, 11, 8, 0.66) 42%, rgba(12, 11, 8, 0.22) 78%, rgba(12, 11, 8, 0.12) 100%),
      linear-gradient(to top, rgba(12, 11, 8, 0.55), rgba(12, 11, 8, 0) 45%);
  }
  .dk-hero__inner {
    min-height: clamp(460px, var(--dk-hero-h, 78), 860px);
    display: flex; align-items: center;
    padding-block: clamp(72px, 12vw, 132px);
  }
  .dk-hero__copy { max-width: 42rem; display: flex; flex-direction: column; gap: 20px; }
  .dk-hero__eyebrow {
    margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: #e2b183;
  }
  .dk-hero__title {
    margin: 0; color: #fff;
    font-family: var(--font-heading--family, inherit); font-weight: 700;
    font-size: clamp(2.75rem, 6.6vw, 5.25rem); line-height: 0.95; letter-spacing: -0.035em; text-wrap: balance;
  }
  .dk-hero__body { margin: 0; max-width: 46ch; color: rgba(255, 255, 255, 0.82); font-size: 1.0625rem; line-height: 1.6; }
  .dk-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 26px; margin-top: 10px; }
  .dk-hero__cta { background: #fbf9f6; border-color: #fbf9f6; color: var(--dk-ink); min-height: 56px; padding-inline: 34px; }
  .dk-hero__cta:hover { background: var(--dk-clay); border-color: var(--dk-clay); color: #fff; }
  .dk-hero__link {
    display: inline-flex; align-items: center; gap: 8px; color: #fff; text-decoration: none;
    font-weight: 600; font-size: 0.9375rem; border-bottom: 1px solid rgba(255, 255, 255, 0.35); padding-bottom: 3px;
  }
  .dk-hero__link svg { width: 15px; height: 15px; transition: transform 0.25s var(--dk-ease); }
  .dk-hero__link:hover svg { transform: translateX(4px); }
  .dk-hero__striprow { background: rgba(12, 11, 8, 0.55); border-top: 1px solid rgba(255, 255, 255, 0.14); backdrop-filter: blur(6px); }
  .dk-hero__strip {
    list-style: none; margin: 0; padding: 16px 0; display: grid; gap: 10px 24px;
    grid-template-columns: repeat(2, 1fr);
    font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: rgba(255, 255, 255, 0.85);
  }
  @media (min-width: 750px) { .dk-hero__strip { grid-template-columns: repeat(4, 1fr); text-align: center; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 90, "step": 2, "unit": "vh", "default": 78 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Desk mats, made for long hours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your desk, finally finished." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "One surface that quiets the keys, glides under the mouse and gives the whole desk a single, deliberate edge." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop the Desk Mat" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link", "default": "See the details" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link URL" },
    { "type": "header", "content": "Strip" },
    { "type": "text", "id": "strip_1", "label": "Item 1", "default": "Delivery across Pakistan" },
    { "type": "text", "id": "strip_2", "label": "Item 2", "default": "Cash on delivery" },
    { "type": "text", "id": "strip_3", "label": "Item 3", "default": "Easy returns" },
    { "type": "text", "id": "strip_4", "label": "Item 4", "default": "Ships from Lahore" }
  ],
  "presets": [{ "name": "DK Hero" }]
}
{% endschema %}
