<section class="dk dk-contact">
  <div class="dk-wrap dk-contact__grid">
    <aside class="dk-contact__aside">
      <p class="dk-eyebrow" data-dk-reveal>{{ section.settings.eyebrow }}</p>
      <h1 class="dk-contact__title" data-dk-reveal data-dk-delay="60">{{ section.settings.heading }}</h1>
      <p class="dk-body" data-dk-reveal data-dk-delay="110">{{ section.settings.body }}</p>

      <ul class="dk-contact__facts" data-dk-reveal data-dk-delay="160">
        {%- for i in (1..3) -%}
          {%- assign lk = 'fact_label_' | append: i -%}
          {%- assign vk = 'fact_value_' | append: i -%}
          {%- if section.settings[lk] != blank -%}
            <li>
              <span class="dk-contact__fact-label">{{ section.settings[lk] }}</span>
              <span class="dk-contact__fact-value">{{ section.settings[vk] }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <a class="dk-contact__faq" href="{{ section.settings.faq_link | default: '/pages/faq' }}">Read the FAQ first
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </aside>

    <div class="dk-contact__panel" data-dk-reveal="fade" data-dk-delay="120">
      {%- form 'contact', class: 'dk-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="dk-form__ok">Thanks — your message is with us. We will reply to the email you gave.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="dk-form__err">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="dk-form__row">
          <div class="dk-field">
            <label for="dk-name">Name</label>
            <input id="dk-name" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
          </div>
          <div class="dk-field">
            <label for="dk-email">Email</label>
            <input id="dk-email" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
          </div>
        </div>

        <div class="dk-field">
          <label for="dk-order">Order number <span>(optional)</span></label>
          <input id="dk-order" type="text" name="contact[order]" value="">
        </div>

        <div class="dk-field">
          <label for="dk-body">How can we help?</label>
          <textarea id="dk-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="dk-btn dk-form__submit">Send message</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .dk-contact { background: var(--dk-paper); padding-block: clamp(40px, 6vw, 84px); }
  .dk-contact__grid { display: grid; gap: clamp(28px, 4vw, 56px); align-items: start; }
  .dk-contact__aside { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .dk-contact__title { margin: 0; font-family: var(--font-heading--family, inherit); font-weight: 700; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.02; letter-spacing: -0.03em; }
  .dk-contact__facts { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 14px; width: 100%; }
  .dk-contact__facts li { display: flex; flex-direction: column; gap: 2px; padding-bottom: 12px; border-bottom: 1px solid var(--dk-stone); }
  .dk-contact__fact-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dk-muted); }
  .dk-contact__fact-value { font-size: 0.9375rem; color: var(--dk-ink); }
  .dk-contact__faq { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; font-weight: 600; color: var(--dk-clay-dark); text-decoration: none; }
  .dk-contact__faq svg { width: 14px; height: 14px; transition: transform 0.25s var(--dk-ease); }
  .dk-contact__faq:hover svg { transform: translateX(4px); }

  .dk-contact__panel { background: var(--dk-sand); border: 1px solid var(--dk-stone); border-radius: 10px; padding: clamp(20px, 3vw, 32px); }
  .dk-form { display: flex; flex-direction: column; gap: 16px; }
  .dk-form__row { display: grid; gap: 16px; grid-template-columns: 1fr; }
  .dk-field { display: flex; flex-direction: column; gap: 6px; }
  .dk-field label { font-size: 0.8125rem; font-weight: 600; color: var(--dk-ink); }
  .dk-field label span { color: var(--dk-muted); font-weight: 400; }
  .dk-field input, .dk-field textarea {
    width: 100%; font: inherit; color: var(--dk-ink);
    background: var(--dk-paper); border: 1px solid var(--dk-stone); border-radius: 6px;
    padding: 12px 14px; transition: border-color 0.2s var(--dk-ease), box-shadow 0.2s var(--dk-ease);
  }
  .dk-field input:focus, .dk-field textarea:focus { outline: none; border-color: var(--dk-clay); box-shadow: 0 0 0 3px rgba(47, 107, 255, 0.15); }
  .dk-form__submit { align-self: flex-start; min-width: 190px; }
  .dk-form__ok { margin: 0; padding: 12px 14px; border-radius: 6px; background: rgba(15, 138, 77, 0.12); color: #0f8a4d; font-size: 0.9375rem; }
  .dk-form__err { margin: 0; padding: 12px 14px; border-radius: 6px; background: rgba(255, 77, 46, 0.12); color: #c22d14; font-size: 0.9375rem; }
  @media (min-width: 750px) { .dk-form__row { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .dk-contact__grid { grid-template-columns: 0.85fr 1.15fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us about your order." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Questions about a delivery, a return or which surface suits your desk — send them over and we will come back to you." },
    { "type": "text", "id": "fact_label_1", "label": "Fact 1 label", "default": "Ships from" },
    { "type": "text", "id": "fact_value_1", "label": "Fact 1 value", "default": "Lahore, Pakistan" },
    { "type": "text", "id": "fact_label_2", "label": "Fact 2 label", "default": "Response time" },
    { "type": "text", "id": "fact_value_2", "label": "Fact 2 value", "default": "We reply to messages in the order they arrive" },
    { "type": "text", "id": "fact_label_3", "label": "Fact 3 label", "default": "Order help" },
    { "type": "text", "id": "fact_value_3", "label": "Fact 3 value", "default": "Include your order number so we can find it quickly" },
    { "type": "url", "id": "faq_link", "label": "FAQ link" }
  ]
}
{% endschema %}
