<section class="dk dk-brand">
  <div class="dk-wrap dk-brand__grid">
    <div class="dk-brand__copy">
      <p class="dk-eyebrow" data-dk-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="dk-h2" data-dk-reveal data-dk-delay="60">{{ section.settings.heading }}</h2>
      <p class="dk-body" data-dk-reveal data-dk-delay="110">{{ section.settings.body }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a class="dk-btn dk-btn--ghost" href="{{ section.settings.cta_link | default: '/pages/about' }}" data-dk-reveal data-dk-delay="160">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <figure class="dk-brand__media" data-dk-reveal="scale">
      <img src="{{ section.settings.image | default: 'dk-context.jpg' | asset_url }}" alt="{{ section.settings.alt }}" loading="lazy" width="1600" height="1200">
    </figure>
  </div>
</section>

{% stylesheet %}
  .dk-brand { background: var(--dk-forest); color: #f1efe6; padding-block: clamp(56px, 9vw, 112px); }
  .dk-brand__grid { display: grid; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .dk-brand__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .dk-brand .dk-eyebrow { color: var(--dk-butter); }
  .dk-brand .dk-h2 { color: #fff; }
  .dk-brand .dk-body { color: rgba(241, 239, 230, 0.78); }
  .dk-brand .dk-btn--ghost { color: #fff; border-color: rgba(255, 255, 255, 0.4); background: transparent; }
  .dk-brand .dk-btn--ghost:hover { background: #fff; color: var(--dk-forest); border-color: #fff; }
  .dk-brand__media { margin: 0; border-radius: 4px; overflow: hidden; aspect-ratio: 4 / 3; }
  .dk-brand__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (min-width: 900px) { .dk-brand__grid { grid-template-columns: 0.9fr 1.1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Brand",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DeskKart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We make one thing, and we make it the centre of the desk." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "DeskKart is a workspace brand built around a simple idea: the surface you work on deserves as much thought as the hardware you put on it. We started with the desk mat because it is the piece that touches everything else — and the one most setups are missing." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "About DeskKart" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "image", "label": "Image asset", "default": "dk-context.jpg" },
    { "type": "text", "id": "alt", "label": "Image alt", "default": "Desk mat with everyday desk objects" }
  ],
  "presets": [{ "name": "DK Brand" }]
}
{% endschema %}
