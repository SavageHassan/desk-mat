{%- liquid
  assign coll = collections[section.settings.collection]
  if coll == blank or coll.products_count == 0
    assign items = collections.all.products
  else
    assign items = coll.products
  endif
  assign is_rail = false
  if section.settings.layout == 'rail'
    assign is_rail = true
  endif
-%}
<section class="dk dk-grid{% if is_rail %} dk-grid--rail{% endif %}">
  <div class="dk-wrap"{% if is_rail %} data-dk-rail{% endif %}>
    <div class="dk-grid__head">
      <div>
        <p class="dk-eyebrow" data-dk-reveal>{{ section.settings.eyebrow }}</p>
        <h2 class="dk-h2" data-dk-reveal data-dk-delay="60">{{ section.settings.heading }}</h2>
      </div>
      <div class="dk-grid__tools">
        <a class="dk-arrowlink" href="{{ routes.all_products_collection_url }}">View all
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {%- if is_rail -%}
          <div class="dk-rail__nav">
            <button type="button" class="dk-rail__btn" data-dk-rail-prev aria-label="Scroll left">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="dk-rail__btn" data-dk-rail-next aria-label="Scroll right">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if is_rail -%}
      <div class="dk-rail">
        <ul class="dk-rail__track" data-dk-rail-track>
          {%- for item in items limit: section.settings.max_products -%}
            {% render 'dk-product-card', product: item, index: forloop.index0 %}
          {%- endfor -%}
        </ul>
        <div class="dk-rail__progress"><span class="dk-rail__bar" data-dk-rail-bar></span></div>
      </div>
    {%- else -%}
      <ul class="dk-grid__list">
        {%- for item in items limit: section.settings.max_products -%}
          {% render 'dk-product-card', product: item, index: forloop.index0 %}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .dk-grid { background: var(--dk-paper); padding-block: clamp(48px, 7vw, 100px); }
  .dk-grid__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: clamp(22px, 3vw, 38px); }
  .dk-grid__head .dk-eyebrow { margin-bottom: 10px; }
  .dk-grid__tools { display: flex; align-items: center; gap: 18px; }
  .dk-grid__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }

  .dk-pcard { display: flex; flex-direction: column; background: var(--dk-card); border: 0; overflow: hidden; transition: box-shadow 0.35s var(--dk-ease), transform 0.35s var(--dk-ease); }
  .dk-pcard:hover { box-shadow: 0 18px 44px rgba(20, 20, 20, 0.1); transform: translateY(-4px); }
  .dk-pcard__media { position: relative; display: block; aspect-ratio: 1 / 1; background: var(--dk-sand); overflow: hidden; }
  .dk-pcard__link { position: absolute; inset: 0; display: block; }
  .dk-pcard__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.45s var(--dk-ease), transform 0.8s var(--dk-ease); }
  .dk-pcard__img--alt { opacity: 0; }
  .dk-pcard:hover .dk-pcard__img--alt { opacity: 1; }
  .dk-pcard:hover .dk-pcard__img { transform: scale(1.05); }
  .dk-pcard__badge { position: absolute; top: 10px; left: 10px; z-index: 4; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 9px; color: #fff; }
  .dk-pcard__badge--sale { background: var(--dk-flash); }
  .dk-pcard__badge--out { background: var(--dk-muted); }
  .dk-pcard__body { padding: 16px 16px 20px; display: flex; flex-direction: column; gap: 7px; flex: 1; }
  .dk-pcard__title { margin: 0; font-size: 1rem; font-weight: 500; line-height: 1.3; }
  .dk-pcard__title a { color: inherit; text-decoration: none; }
  .dk-pcard__price { margin: auto 0 0; font-size: 0.9375rem; font-weight: 500; color: var(--dk-ink); padding-top: 4px; }
  .dk-pcard__price s { color: var(--dk-muted); font-weight: 400; margin-left: 6px; }
  .dk-pcard__form { display: contents; }

  @media (min-width: 750px) { .dk-grid__list { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  @media (min-width: 1100px) { .dk-grid__list { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 749px) { .dk-grid__head { flex-direction: column; align-items: flex-start; gap: 14px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Product grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "rail", "label": "Horizontal rail" }
      ] },
    { "type": "range", "id": "max_products", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop desk mats" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your surface." }
  ],
  "presets": [{ "name": "DK Product grid" }]
}
{% endschema %}
