<section class="dk dk-bar">
  <div class="dk-wrap">
    <ul class="dk-bar__grid">
      {%- for block in section.blocks -%}
        <li class="dk-bar__item" {{ block.shopify_attributes }}>
          <span class="dk-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 10a9 9 0 1 1 2 7"/><path d="M3 5v5h5"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l8 3v6c0 5-3.6 8-8 9-4.4-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3v18M3 12h18"/></svg>
            {%- endcase -%}
          </span>
          <div>
            <p class="dk-bar__title">{{ block.settings.title }}</p>
            <p class="dk-bar__sub">{{ block.settings.subtitle }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .dk-bar { background: var(--dk-paper); padding-block: clamp(28px, 4vw, 44px); border-block: 1px solid var(--dk-stone); }
  .dk-bar__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px 32px; grid-template-columns: repeat(2, 1fr); }
  .dk-bar__item { display: flex; gap: 14px; align-items: flex-start; }
  .dk-bar__icon { flex: none; width: 26px; height: 26px; color: var(--dk-clay-dark); }
  .dk-bar__icon svg { width: 100%; height: 100%; stroke-linecap: round; stroke-linejoin: round; }
  .dk-bar__title { margin: 0; font-weight: 600; font-size: 0.9375rem; color: var(--dk-ink); }
  .dk-bar__sub { margin: 2px 0 0; font-size: 0.8125rem; color: var(--dk-muted); }
  @media (min-width: 750px) { .dk-bar__grid { grid-template-columns: repeat(4, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Trust bar",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"truck","label":"Delivery"},{"value":"return","label":"Returns"},{"value":"shield","label":"Guarantee"},{"value":"plus","label":"Generic"}], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Subtitle" }
      ]
    }
  ],
  "presets": [{ "name": "DK Trust bar" }]
}
{% endschema %}
