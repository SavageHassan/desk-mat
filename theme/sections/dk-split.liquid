<section class="dk dk-split dk-split--{{ section.settings.media_position }}">
  <div class="dk-wrap dk-split__grid">
    <div class="dk-split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'dk-split__img', alt: section.settings.heading }}
      {%- else -%}
        <span class="dk-placeholder-tag">Placeholder artwork</span>
        <img class="dk-split__img" src="{{ 'dk-ph-lifestyle.svg' | asset_url }}" alt="Placeholder workspace illustration" width="1400" height="1000" loading="lazy">
      {%- endif -%}
    </div>
    <div class="dk-split__copy">
      <p class="dk-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dk-h2">{{ section.settings.heading }}</h2>
      <p class="dk-body">{{ section.settings.body }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a class="dk-btn dk-btn--ghost" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .dk-split { background: var(--dk-paper); padding-block: clamp(56px, 9vw, 112px); }
  .dk-split__grid { display: grid; gap: clamp(28px, 4vw, 64px); align-items: center; }
  .dk-split__media { position: relative; border-radius: 6px; overflow: hidden; background: var(--dk-sand); aspect-ratio: 7 / 5; }
  .dk-split__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dk-split__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  @media (min-width: 750px) {
    .dk-split__grid { grid-template-columns: 1.1fr 0.9fr; }
    .dk-split--right .dk-split__media { order: 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Split feature",
  "settings": [
    { "type": "select", "id": "media_position", "label": "Media position", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the desk you actually use." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Placeholder copy. Final wording will follow the confirmed product specification — size, material and finish." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "See the specs" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "DK Split feature" }]
}
{% endschema %}
