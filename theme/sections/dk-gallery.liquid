<section class="dk dk-gallery">
  <div class="dk-wrap">
    <div class="dk-gallery__head">
      <p class="dk-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dk-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="dk-body">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="dk-gallery__grid">
      {%- for block in section.blocks -%}
        <figure class="dk-gallery__item dk-gallery__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'dk-gallery__img', alt: block.settings.caption }}
          {%- else -%}
            <img class="dk-gallery__img" src="{{ block.settings.fallback | default: 'dk-life-2.jpg' | asset_url }}" alt="{{ block.settings.caption }}" loading="lazy" width="1400" height="1000">
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption>{{ block.settings.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .dk-gallery { background: var(--dk-paper); padding-block: clamp(56px, 9vw, 112px); }
  .dk-gallery__head { display: flex; flex-direction: column; gap: 12px; max-width: 52ch; margin-bottom: clamp(28px, 4vw, 48px); }
  .dk-gallery__grid { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  .dk-gallery__item { margin: 0; position: relative; overflow: hidden; border-radius: 4px; background: var(--dk-sand); aspect-ratio: 4 / 3; }
  .dk-gallery__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--dk-ease); }
  .dk-gallery__item:hover .dk-gallery__img { transform: scale(1.04); }
  .dk-gallery__item figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 16px 14px;
    font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.04em; color: #fff;
    background: linear-gradient(to top, rgba(14, 12, 9, 0.68), rgba(14, 12, 9, 0));
  }
  @media (min-width: 750px) {
    .dk-gallery__grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 1fr; }
    .dk-gallery__item--1 { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "On real desks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looks right in any setup." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Warm wood, white minimal, dark battlestation — the mat is the piece that ties the surface together." }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Shot",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "dk-life-2.jpg" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Desk setup" }
      ]
    }
  ],
  "presets": [{ "name": "DK Gallery" }]
}
{% endschema %}
