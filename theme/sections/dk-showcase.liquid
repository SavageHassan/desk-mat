{%- liquid
  assign p = section.settings.product
-%}
<section class="dk dk-showcase" id="dk-details">
  <div class="dk-wrap dk-showcase__grid">
    <div class="dk-showcase__media">
      {%- if p != blank and p.featured_media != blank -%}
        {{ p.featured_media | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'dk-showcase__img', alt: p.title }}
      {%- else -%}
        <span class="dk-placeholder-tag">Placeholder artwork</span>
        <img class="dk-showcase__img" src="{{ 'dk-ph-detail.svg' | asset_url }}" alt="Placeholder desk mat detail illustration" width="1200" height="1200" loading="lazy">
      {%- endif -%}
    </div>

    <div class="dk-showcase__copy">
      <p class="dk-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dk-h2">{%- if p != blank -%}{{ p.title }}{%- else -%}{{ section.settings.heading }}{%- endif -%}</h2>

      {%- if p != blank -%}
        <p class="dk-showcase__price">{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</p>
      {%- else -%}
        <p class="dk-showcase__price dk-showcase__price--empty">Price to be set</p>
      {%- endif -%}

      <p class="dk-body">{%- if p != blank and p.description != blank -%}{{ p.description | strip_html | truncatewords: 48 }}{%- else -%}{{ section.settings.body }}{%- endif -%}</p>

      {%- if section.settings.point_1 != blank -%}
        <ul class="dk-showcase__points">
          {%- for i in (1..4) -%}
            {%- assign key = 'point_' | append: i -%}
            {%- assign val = section.settings[key] -%}
            {%- if val != blank -%}
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ val }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if p != blank -%}
        {%- form 'product', p, class: 'dk-showcase__form' -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <button type="submit" class="dk-btn" {% unless p.available %}disabled{% endunless %}>
            {% if p.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
          <a class="dk-btn dk-btn--ghost" href="{{ p.url }}">Full details</a>
        {%- endform -%}
      {%- else -%}
        <div class="dk-showcase__form">
          <a class="dk-btn" href="{{ routes.all_products_collection_url }}">Shop now</a>
        </div>
        <p class="dk-showcase__note">No product is connected to this section yet. Assign the Desk Mat product in the theme editor and the title, price, description and Add to cart button all switch to live Shopify data.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .dk-showcase { background: var(--dk-paper); padding-block: clamp(56px, 9vw, 112px); }
  .dk-showcase__grid { display: grid; gap: clamp(28px, 4vw, 64px); align-items: center; }
  .dk-showcase__media { position: relative; border-radius: 6px; overflow: hidden; background: var(--dk-sand); aspect-ratio: 1 / 1; }
  .dk-showcase__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dk-showcase__copy { display: flex; flex-direction: column; gap: 18px; }
  .dk-showcase__price { font-size: 1.25rem; font-weight: 600; margin: 0; color: var(--dk-ink); }
  .dk-showcase__price--empty { color: var(--dk-muted); font-weight: 500; }
  .dk-showcase__price s { color: var(--dk-muted); font-weight: 400; margin-left: 8px; }
  .dk-showcase__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .dk-showcase__points li { display: flex; gap: 12px; align-items: flex-start; font-size: 0.9375rem; color: var(--dk-ink-soft); }
  .dk-showcase__points svg { width: 16px; height: 16px; flex: none; margin-top: 4px; color: var(--dk-clay-dark); }
  .dk-showcase__form { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .dk-showcase__note { font-size: 0.8125rem; color: var(--dk-muted); margin: 0; max-width: 46ch; }
  @media (min-width: 750px) { .dk-showcase__grid { grid-template-columns: 1fr 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Product showcase",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The product" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "The Desk Mat" },
    { "type": "textarea", "id": "body", "label": "Fallback body", "default": "One surface for keyboard, mouse and everything else the day puts on your desk." },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Full-desk coverage for keyboard and mouse" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Smooth, consistent tracking surface" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Wipes clean in seconds" },
    { "type": "text", "id": "point_4", "label": "Point 4", "default": "Lies flat, stays put" }
  ],
  "presets": [{ "name": "DK Product showcase" }]
}
{% endschema %}
