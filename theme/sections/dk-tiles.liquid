<section class="dk dk-tiles">
  <div class="dk-wrap">
    <div class="dk-tiles__head">
      <div>
        <p class="dk-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="dk-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="dk-tiles__all" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="dk-tiles__grid">
      {%- for block in section.blocks -%}
        <li class="dk-tiles__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            <span class="dk-tiles__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'dk-tiles__img', alt: block.settings.title }}
              {%- else -%}
                <img class="dk-tiles__img" src="{{ block.settings.fallback | default: 'dk-life-1.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy" width="1200" height="900">
              {%- endif -%}
            </span>
            <span class="dk-tiles__meta">
              <span class="dk-tiles__title">{{ block.settings.title }}</span>
              <span class="dk-tiles__sub">{{ block.settings.subtitle }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .dk-tiles { background: var(--dk-paper); padding-block: clamp(48px, 7vw, 92px); }
  .dk-tiles__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: clamp(24px, 3vw, 40px); }
  .dk-tiles__head .dk-eyebrow { margin-bottom: 8px; }
  .dk-tiles__all { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; font-weight: 600; color: var(--dk-ink); text-decoration: none; white-space: nowrap; }
  .dk-tiles__all svg { width: 15px; height: 15px; transition: transform 0.25s var(--dk-ease); }
  .dk-tiles__all:hover svg { transform: translateX(4px); }
  .dk-tiles__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: 1fr; }
  .dk-tiles__item a { display: block; text-decoration: none; color: inherit; }
  .dk-tiles__media { display: block; position: relative; overflow: hidden; border-radius: 4px; background: var(--dk-sand); aspect-ratio: 4 / 3; }
  .dk-tiles__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--dk-ease); }
  .dk-tiles__item a:hover .dk-tiles__img { transform: scale(1.045); }
  .dk-tiles__meta { display: flex; flex-direction: column; gap: 2px; padding-top: 12px; }
  .dk-tiles__title { font-weight: 600; font-size: 1rem; }
  .dk-tiles__sub { font-size: 0.875rem; color: var(--dk-muted); }
  @media (min-width: 750px) { .dk-tiles__grid { grid-template-columns: repeat(3, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Start here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need to know." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the Desk Mat" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "dk-life-1.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Subtitle" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "DK Tiles" }]
}
{% endschema %}
