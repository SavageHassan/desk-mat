    "intro": {
      "type": "dk-intro",
      "settings": {
        "eyebrow": "The product",
        "heading": "One surface. The whole desk makes sense.",
        "body": "A desk mat is the quietest upgrade you can make. It gives the keyboard a softer floor, the mouse an even run, and everything else a boundary to sit inside \u2014 so the desk reads as one considered surface instead of scattered hardware.",
        "cta_label": "Shop the range",
        "cta_link": "/collections/all",
        "image_1": "dk-lifestyle.jpg",
        "alt_1": "Desk mat on a wooden desk with keyboard and laptop",
        "image_2": "dk-detail.jpg",
        "alt_2": "Close-up of the desk mat surface in use"
      }
