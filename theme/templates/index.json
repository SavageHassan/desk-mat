    "brand": {
      "type": "dk-brand",
      "settings": {
        "eyebrow": "DeskKart",
        "heading": "We make one thing, and we make it the centre of the desk.",
        "body": "DeskKart is a workspace brand built around a simple idea: the surface you work on deserves as much thought as the hardware you put on it. We started with the desk mat because it is the piece that touches everything else \u2014 and the one most setups are missing.",
        "cta_label": "About DeskKart",
        "cta_link": "/pages/about",
        "image": "dk-context.jpg",
        "alt": "Desk mat with everyday desk objects"
      }
    },
    "faq": {
      "type": "dk-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What exactly is a desk mat?",
            "answer": "A single large surface that sits on your desk and holds your keyboard, mouse and everyday items. It defines the working area, softens the surface under your hardware and protects the desk underneath."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How do I choose the right one for my desk?",
            "answer": "Measure the span your keyboard and mouse occupy when you work comfortably, then leave room on either side. Confirmed sizes for this mat are listed in the specification section once finalised."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "Orders are dispatched from Lahore. Delivery times and charges are shown at checkout and set by the store's shipping policy."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Can I pay cash on delivery?",
            "answer": "The payment methods available to you are shown at checkout once the store's payment providers are active."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "What if it is not right for my desk?",
            "answer": "Returns are handled under the store's refund policy. Contact us with your order number and we will take it from there."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "How do I keep it clean?",
            "answer": "A damp cloth handles everyday dust and marks. Let it dry flat before putting hardware back on top."
          }
        }
      },
