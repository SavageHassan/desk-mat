    "features": {
      "type": "dk-features",
      "blocks": {
        "f1": {
          "type": "feature",
          "settings": {
            "title": "A quieter desk",
            "body": "The mat takes the hard edge off key chatter and mouse clicks \u2014 the difference shows up on long calls and late sessions."
          }
        },
        "f2": {
          "type": "feature",
          "settings": {
            "title": "Edge-to-edge tracking",
            "body": "An even surface means the cursor behaves the same at the far corner as it does in the middle. No dead patches, no hunting."
          }
        },
        "f3": {
          "type": "feature",
          "settings": {
            "title": "One defined surface",
            "body": "Keyboard, mouse, phone, notebook. Everything lands inside one boundary instead of drifting across the desk."
          }
        },
        "f4": {
          "type": "feature",
          "settings": {
            "title": "Kinder to the desk",
            "body": "A layer between hardware and the desktop keeps scuffs, scratches and coffee rings off the surface underneath."
          }
        },
        "f5": {
          "type": "feature",
          "settings": {
            "title": "Wipes clean",
            "body": "Dust, crumbs and the occasional spill come off with a damp cloth. No special treatment required."
          }
        },
        "f6": {
          "type": "feature",
          "settings": {
            "title": "Looks considered",
            "body": "The fastest way to make a desk look finished rather than assembled \u2014 one rectangle pulling the setup together."
          }
        }
      },
